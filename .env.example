# Copy this file to .env.local and fill in the keys. .env.local is not committed.

# Nutrient Web SDK license key (removes the evaluation watermark).
# Leave empty to run in trial mode.
VITE_NUTRIENT_LICENSE_KEY=

# Nutrient DWS Processor API key (nutr_sk_...), from https://dashboard.nutrient.io/sign_up/?product=processor
# Used only by the dev/preview server; it is never sent to the browser.
NUTRIENT_API_KEY=
